{
  "files.exclude": {
    "**/.idea": true,
    "**/__debug_bin.exe": true,
    "**/.dart_tool": true,
    "**/build": true,
    "**/.flutter-plugins-dependencies": true,
    "**/.metadata": true,
    "**/.kotlin": true,
    "**/analysis_options.yaml": true,
    "**/*.iml": true,
    "**/ios": true,
    "**/linux": true,
    "**/macos": true,
    "**/web": true,
    "**/windows": true,
    "**/android": true,
    "**/test": true,
    "**/.gitattributes": true,
    // "**/.gitignore": true,
    "**/pubspec.lock": true,
    "**/LICENSE": true,
    "**/devtools_options.yaml": true,
    "**/flutter_launcher_icons.yaml": true,

    "**/app_localizations_en.dart": true,
    "**/app_localizations_ja.dart": true,
    "**/app_localizations_pl.dart": true,
    "**/app_localizations.dart": true,

    "**/*g.dart": true,

    "**/l10n.yaml": true
    // "**/README.md": true
  },

  "search.exclude": {
    "**/.idea": true,
    "**/__debug_bin.exe": true,
    "**/.dart_tool": true,
    "**/build": true,
    "**/.flutter-plugins-dependencies": true,
    "**/.metadata": true,
    "**/.kotlin": true,
    "**/raw_assets": true,
    "**/analysis_options.yaml": true,
    "**/*.iml": true,
    "**/ios": true,
    "**/linux": true,
    "**/macos": true,
    "**/web": true,
    "**/windows": true,
    "**/test": true,
    "**/pubspec.lock": true,
    "**/pubspec.yaml": true,
    "**/README.md": true,
    "**/.gitattributes": true,
    "**/.gitignore": true,
    "**/.vscode": true,
    "**/docs": true,
    "**/android": true,
    "**/LICENSE": true,
    "**/devtools_options.yaml": true,
    "**/flutter_launcher_icons.yaml": true,
    "**/*.freezed.dart": true,
    "**/*.g.dart": true,
    "**/assets": true,
    "**/*.txt": true
  },

  "dart.lineLength": 80,

  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  },

  "[dart]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
      "source.fixAll": "always"
    },
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.selectionHighlight": false
  },

  "dart.analysisExcludedFolders": ["**/build", "**/.dart_tool"],

  "dart.updateImportsOnRename": true,
  "dart.completeFunctionCalls": true
}
