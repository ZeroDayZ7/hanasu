{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend Server (Local Engine)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/backend/cmd/server/main.go",
      "cwd": "${workspaceFolder}/services/backend",
      "env": {
        "PORT": "8080",
        "TRANSLATION_PROVIDER": "local",
        "OLLAMA_URL": "http://localhost:11434"
      },
      "showLog": false
    },
    {
      "name": "Backend Server (OpenAI Engine)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/backend/cmd/server/main.go",
      "cwd": "${workspaceFolder}/services/backend",
      "env": {
        "PORT": "8080",
        "TRANSLATION_PROVIDER": "openai",
        "OPENAI_API_KEY": "your_key_here"
      },
      "showLog": false
    },
    {
      "name": "Flutter Android (USB)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/apps/app",
      "program": "lib/main.dart",
      "deviceId": "5200d78bfa479449"
    },
    {
      "name": "Flutter Android (Tailscale WiFi)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/apps/app",
      "program": "lib/main.dart",
      "deviceId": "100.87.236.2:5555"
    },
    {
      "name": "Flutter on Windows",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/apps/app",
      "program": "lib/main.dart",
      "deviceId": "windows"
    }
  ]
}
